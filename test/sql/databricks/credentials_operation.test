# name: test/sql/databricks/credentials_operation.test
# description: Verify that READ credentials are requested for SELECT and READ_WRITE for INSERT
# group: [databricks]

require parquet

require unity_catalog

require delta

require httpfs

require-env DATABRICKS_TOKEN

require-env DATABRICKS_ENDPOINT

require-env DATABRICKS_REGION

require-env DATABRICKS_WRITE_TEST_CATALOG

require-env DATABRICKS_WRITE_TEST_SCHEMA

statement ok
CALL enable_logging('HTTP');

statement ok
CREATE SECRET (
    TYPE UC,
    TOKEN '${DATABRICKS_TOKEN}',
    ENDPOINT '${DATABRICKS_ENDPOINT}',
    AWS_REGION '${DATABRICKS_REGION}'
);

statement ok
ATTACH '${DATABRICKS_WRITE_TEST_CATALOG}' as databricks_catalog (TYPE UNITY_CATALOG, DEFAULT_SCHEMA '${DATABRICKS_WRITE_TEST_SCHEMA}');

statement ok
USE databricks_catalog;

# Read path: SELECT should trigger a READ credential request
statement ok
SELECT * FROM simple_table LIMIT 1;

# Verify the credential request for the read used "READ" operation (not "READ_WRITE")
query I
SELECT request.body LIKE '%"operation" : "READ"%' AND request.body NOT LIKE '%"operation" : "READ_WRITE"%'
    FROM duckdb_logs_parsed('HTTP')
    WHERE request.url LIKE '%temporary-table-credentials%'
    ORDER BY timestamp DESC
    LIMIT 1;
----
true

# Write path: INSERT should trigger a READ_WRITE credential request
statement ok
INSERT INTO simple_table VALUES (999, 'credentials-test-value');

# Verify the credential request for the write used "READ_WRITE" operation
query I
SELECT request.body LIKE '%"operation" : "READ_WRITE"%'
    FROM duckdb_logs_parsed('HTTP')
    WHERE request.url LIKE '%temporary-table-credentials%'
    ORDER BY timestamp DESC
    LIMIT 1;
----
true
